Attendance Aggregation;
ZenClassDB> db.attendance.aggregate([
...   {
...     $match: {
...       date: { $gte: ISODate("2020-10-15"), $lte: ISODate("2020-10-31") },
...       status: "absent"
...     }
...   },
...   {
...     $lookup: {
...       from: "tasks",
...       localField: "user_id",
...       foreignField: "user_id",
...       as: "user_tasks"
...     }
...   },
...   {
...     $match: {
...       "user_tasks.submitted": false
...     }
...   },
...   {
...     $count: "absent_and_not_submitted"
...   }
... ])
